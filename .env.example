# Copy this file to `.env` and fill in your real values.
# ⚠️ NEVER commit .env to version control.

# ── Django ───────────────────────────────────────────────────────────────
# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-django-key-here
DEBUG=True

# ── Database ─────────────────────────────────────────────────────────────
# If DATABASE_URL is set it wins and the app connects to Postgres
# (supports SQLite, PostgreSQL, MySQL via connection string). Examples:
#   PostgreSQL/Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#   SQLite:          sqlite:///path/to/db.sqlite3
# DATABASE_URL=

# Local MySQL dev fallback (only used when DATABASE_URL is blank):
DB_NAME=foodcourt
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ── Paystack ────────────────────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CURRENCY=NGN

# ── Resend email ────────────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
DEFAULT_FROM_EMAIL=Choply <onboarding@resend.dev>

# ── Google OAuth ────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/google-auth/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Site URL ────────────────────────────────────────────────────────────
SITE_URL=https://yourdomain.com

# ── Cloudinary (image storage) ──────────────────────────────────────────
# Required for uploaded images (restaurant logos/covers, menu items, avatars)
# to persist on Render. Create a free account at https://cloudinary.com
# then copy the keys from the Cloudinary dashboard.
# If these are not set, uploads fall back to local filesystem (dev only).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
