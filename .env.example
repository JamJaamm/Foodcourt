# Copy this file to `.env` and fill in your real values.
# Get Paystack test keys from https://dashboard.paystack.com/#/settings/developers
#   (Test mode: pk_test_... / sk_test_...)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CURRENCY=NGN

# Resend email — get your API key from https://resend.com/api-keys
# Verify your sending domain in Resend dashboard before going to production.
RESEND_API_KEY=re_xxxxxxxxxxxx
DEFAULT_FROM_EMAIL=FoodCourt <noreply@yourdomain.com>
SITE_URL=https://yourdomain.com
